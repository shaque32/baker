/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self' https://getmabillon.com https://forms.getmabillon.com; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# The demo form posts to forms.getmabillon.com. Under no-referrer a browser sends "Origin: null",
# so this page sends its origin (never a path) instead.
/demo.html
  ! Referrer-Policy
  Referrer-Policy: strict-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pages and their CSS and script must always be revalidated, so a deploy never pairs new HTML
# with a stylesheet a browser cached earlier. The ?v= on each link changes with the file.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/main.js
  Cache-Control: public, max-age=0, must-revalidate
