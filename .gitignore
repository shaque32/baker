__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Case databases and eval outputs
*.db
*.sqlite
eval/out/
# Synthetic reports are rebuilt by `make synth`; case.json pins their SHA-256.
eval/synthetic/*/*.xlsx

# Data safety: real extraction and discovery formats never enter this repo.
# Synthetic fixtures under eval/fixtures/ are allowed explicitly.
*.ufdr
*.ufd
*.ufdx
*.e01
*.mfdb
cases/
discovery/
!eval/fixtures/**
eval/probe/models*.local.json

# Local model files never enter the repo.
*.gguf

# Impeccable design skill (.claude/skills/impeccable). Its engine binary is downloaded on first
# run into ~/.impeccable/bin/ and checked against scripts/engine-checksums.txt, so it is never
# committed. The rest of the block is Impeccable's own list of working files.
.claude/skills/impeccable/scripts/bin/
# impeccable-ignore-start
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
